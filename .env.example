# Server-side OpenAI key. Set this in Replit Secrets, never in browser code.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini

# Supabase is not connected in the current build. These server-only values are
# required before cloud profiles, shared history, and private file storage can
# be enabled.
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
